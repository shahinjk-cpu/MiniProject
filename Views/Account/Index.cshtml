@model PetShopApp.ViewModels.AccountPageVM
@{
    ViewData["Title"] = Model.IsAuthenticated ? "My Account" : "Account - Login / Sign Up";
}

<section id="banner" class="py-3" style="background: #F9F3EC;">
    <div class="container">
        <div class="hero-content py-5 my-3">
            <h2 class="display-1 mt-3 mb-0">@(Model.IsAuthenticated ? "My Profile" : "Account")</h2>
            <nav class="breadcrumb">
                <a class="breadcrumb-item nav-link" asp-controller="Home" asp-action="Index">Home</a>
                <span class="breadcrumb-item active" aria-current="page">Account</span>
            </nav>
        </div>
    </div>
</section>

@if (TempData["SuccessMessage"] != null)
{
    <div class="container mt-4">
        <div class="alert alert-success alert-dismissible fade show rounded-4 p-4 shadow-sm" role="alert">
            <div class="d-flex align-items-center">
                <iconify-icon icon="mdi:check-circle" class="text-success fs-2 me-3"></iconify-icon>
                <div class="fw-bold fs-5">@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

@if (Model.IsAuthenticated && Model.User != null)
{
    <!-- AUTHENTICATED USER DASHBOARD -->
    <div class="container py-5 my-3">
        <div class="row g-4">
            <!-- User Sidebar / Info -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-light">
                    <div class="mx-auto bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold shadow mb-3" style="width: 90px; height: 90px; font-size: 2.2rem;">
                        @(string.IsNullOrEmpty(Model.User.FullName) ? "U" : Model.User.FullName.Substring(0, 1).ToUpper())
                    </div>
                    <h3 class="fw-bold text-dark m-0">@Model.User.FullName</h3>
                    <p class="text-muted mb-3">@Model.User.Email</p>
                    <div class="badge bg-success-subtle text-success px-3 py-2 rounded-pill mb-4">Active Member</div>

                    <div class="text-start border-top pt-3">
                        <p class="mb-2"><strong>Member since:</strong> @Model.User.CreatedAt.ToString("MMM yyyy")</p>
                        <p class="mb-2"><strong>Phone:</strong> @(Model.User.PhoneNumber ?? "Not specified")</p>
                        <p class="mb-0"><strong>Total Orders:</strong> @Model.Orders.Count</p>
                    </div>

                    <div class="border-top pt-4 mt-4 d-grid gap-2">
                        <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-dark rounded-pill">Continue Shopping</a>
                        <form asp-action="Logout" method="post" class="d-grid">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger rounded-pill">Log Out</button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Orders History -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 p-4">
                    <h3 class="fw-bold text-dark mb-4 d-flex justify-content-between align-items-center">
                        <span>Order History</span>
                        <span class="badge bg-primary rounded-pill fs-6 px-3 py-2">@Model.Orders.Count orders</span>
                    </h3>

                    @if (!Model.Orders.Any())
                    {
                        <div class="text-center py-5">
                            <iconify-icon icon="mdi:shopping-outline" class="display-1 text-muted"></iconify-icon>
                            <h4 class="mt-3 text-secondary">No orders yet</h4>
                            <p class="text-muted">You haven't placed any orders yet. Discover our quality pet supplies!</p>
                            <a asp-controller="Shop" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 mt-2">Explore Catalog</a>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Order #</th>
                                        <th>Date</th>
                                        <th>Items</th>
                                        <th>Total</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model.Orders)
                                    {
                                        <tr>
                                            <td class="fw-bold text-primary">@order.OrderCode</td>
                                            <td>@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td>@order.OrderItems.Count item(s)</td>
                                            <td class="fw-bold">$@order.TotalAmount.ToString("N2")</td>
                                            <td>
                                                @switch (order.Status)
                                                {
                                                    case PetShopApp.Models.Enums.OrderStatus.Pending:
                                                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">Gözləyir</span>
                                                        break;
                                                    case PetShopApp.Models.Enums.OrderStatus.Processing:
                                                        <span class="badge bg-info text-dark px-3 py-2 rounded-pill">Hazırlanır</span>
                                                        break;
                                                    case PetShopApp.Models.Enums.OrderStatus.Shipped:
                                                        <span class="badge bg-primary px-3 py-2 rounded-pill">Çatdırılmada</span>
                                                        break;
                                                    case PetShopApp.Models.Enums.OrderStatus.Delivered:
                                                        <span class="badge bg-success px-3 py-2 rounded-pill">Təhvil verildi</span>
                                                        break;
                                                    case PetShopApp.Models.Enums.OrderStatus.Cancelled:
                                                        <span class="badge bg-danger px-3 py-2 rounded-pill">Ləğv edildi</span>
                                                        break;
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- GUEST TABS: LOGIN & SIGN UP -->
    <section class="login-tabs padding-large">
        <div class="container my-5 py-3">
            <div class="row">
                <div class="tabs-listing">
                    <nav>
                        <div class="nav nav-tabs d-flex justify-content-center border-dark-subtle mb-4" id="nav-tab" role="tablist">
                            <button class="nav-link mx-3 fs-3 border-bottom border-dark-subtle border-0 text-uppercase @(Model.ActiveTab == "login" ? "active" : "")"
                                    id="nav-sign-in-tab" data-bs-toggle="tab" data-bs-target="#nav-sign-in" type="button"
                                    role="tab" aria-controls="nav-sign-in" aria-selected="@(Model.ActiveTab == "login" ? "true" : "false")">Log In</button>
                            <button class="nav-link mx-3 fs-3 border-bottom border-dark-subtle border-0 text-uppercase @(Model.ActiveTab == "register" ? "active" : "")"
                                    id="nav-register-tab" data-bs-toggle="tab" data-bs-target="#nav-register" type="button"
                                    role="tab" aria-controls="nav-register" aria-selected="@(Model.ActiveTab == "register" ? "true" : "false")">Sign Up</button>
                        </div>
                    </nav>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="col-lg-8 offset-lg-2 mb-4">
                            <div class="alert alert-danger rounded-4 p-3 shadow-sm" role="alert">
                                <div asp-validation-summary="All" class="text-danger m-0"></div>
                            </div>
                        </div>
                    }

                    <div class="tab-content" id="nav-tabContent">
                        <!-- LOGIN TAB -->
                        <div class="tab-pane fade @(Model.ActiveTab == "login" ? "active show" : "")" id="nav-sign-in" role="tabpanel" aria-labelledby="nav-sign-in-tab">
                            <div class="col-lg-6 offset-lg-3 mt-4 p-4 p-md-5 bg-white border rounded-5 shadow-sm">
                                <p class="mb-2 text-muted fw-bold">Log-In With Social</p>
                                <div class="row mb-4">
                                    <div class="d-grid col-md-6 my-2">
                                        <a href="#" class="btn btn-outline-dark btn-lg text-uppercase fs-6 rounded-pill py-2">
                                            <div class="d-flex align-items-center justify-content-center">
                                                <iconify-icon icon="ion:logo-google" class="signup-social-icon me-2 fs-5"></iconify-icon>
                                                <span>Google</span>
                                            </div>
                                        </a>
                                    </div>
                                    <div class="d-grid col-md-6 my-2">
                                        <a href="#" class="btn btn-outline-dark btn-lg text-uppercase fs-6 rounded-pill py-2">
                                            <div class="d-flex align-items-center justify-content-center">
                                                <iconify-icon icon="ion:logo-facebook" class="signup-social-icon me-2 fs-5"></iconify-icon>
                                                <span>Facebook</span>
                                            </div>
                                        </a>
                                    </div>
                                </div>

                                <div class="position-relative my-4 text-center">
                                    <hr />
                                    <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small">Or Log-In With Email</span>
                                </div>

                                <form asp-action="Login" method="post" class="form-group flex-wrap">
                                    @Html.AntiForgeryToken()
                                    <div class="form-input col-lg-12">
                                        <div class="mb-3">
                                            <label asp-for="Login.Email" class="form-label fw-bold small text-muted">Email address</label>
                                            <input asp-for="Login.Email" type="email" placeholder="Enter email address" class="form-control form-control-lg rounded-3 ps-3" required />
                                            <span asp-validation-for="Login.Email" class="text-danger small"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label asp-for="Login.Password" class="form-label fw-bold small text-muted">Password</label>
                                            <input asp-for="Login.Password" type="password" placeholder="Enter password" class="form-control form-control-lg rounded-3 ps-3" required />
                                            <span asp-validation-for="Login.Password" class="text-danger small"></span>
                                        </div>

                                        <div class="py-2 d-flex flex-wrap justify-content-between align-items-center">
                                            <div class="form-check">
                                                <input asp-for="Login.RememberMe" class="form-check-input" type="checkbox" id="rememberMe">
                                                <label class="form-check-label small" for="rememberMe">
                                                    Remember Me
                                                </label>
                                            </div>

                                            <div>
                                                <a href="#" class="text-primary fw-bold small text-decoration-none">Forgot Password?</a>
                                            </div>
                                        </div>

                                        <div class="d-grid my-4">
                                            <button type="submit" class="btn btn-primary btn-lg rounded-pill py-3 fw-bold fs-5">Log In</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <!-- REGISTER TAB -->
                        <div class="tab-pane fade @(Model.ActiveTab == "register" ? "active show" : "")" id="nav-register" role="tabpanel" aria-labelledby="nav-register-tab">
                            <div class="col-lg-6 offset-lg-3 mt-4 p-4 p-md-5 bg-white border rounded-5 shadow-sm">
                                <p class="mb-2 text-muted fw-bold">Sign-Up With Social</p>
                                <div class="row mb-4">
                                    <div class="d-grid col-md-6 my-2">
                                        <a href="#" class="btn btn-outline-dark btn-lg text-uppercase fs-6 rounded-pill py-2">
                                            <div class="d-flex align-items-center justify-content-center">
                                                <iconify-icon icon="ion:logo-google" class="signup-social-icon me-2 fs-5"></iconify-icon>
                                                <span>Google</span>
                                            </div>
                                        </a>
                                    </div>
                                    <div class="d-grid col-md-6 my-2">
                                        <a href="#" class="btn btn-outline-dark btn-lg text-uppercase fs-6 rounded-pill py-2">
                                            <div class="d-flex align-items-center justify-content-center">
                                                <iconify-icon icon="ion:logo-facebook" class="signup-social-icon me-2 fs-5"></iconify-icon>
                                                <span>Facebook</span>
                                            </div>
                                        </a>
                                    </div>
                                </div>

                                <div class="position-relative my-4 text-center">
                                    <hr />
                                    <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small">Or Sign-Up With Email</span>
                                </div>

                                <form asp-action="Register" method="post" class="form-group flex-wrap">
                                    @Html.AntiForgeryToken()
                                    <div class="form-input col-lg-12">
                                        <div class="mb-3">
                                            <label asp-for="Register.FullName" class="form-label fw-bold small text-muted">Full Name</label>
                                            <input asp-for="Register.FullName" type="text" placeholder="Your full name" class="form-control form-control-lg rounded-3 ps-3" required />
                                            <span asp-validation-for="Register.FullName" class="text-danger small"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label asp-for="Register.Email" class="form-label fw-bold small text-muted">Email address</label>
                                            <input asp-for="Register.Email" type="email" placeholder="Your email address" class="form-control form-control-lg rounded-3 ps-3" required />
                                            <span asp-validation-for="Register.Email" class="text-danger small"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label asp-for="Register.Password" class="form-label fw-bold small text-muted">Password</label>
                                            <input asp-for="Register.Password" type="password" placeholder="Create password (min 6 characters)" class="form-control form-control-lg rounded-3 ps-3" required />
                                            <span asp-validation-for="Register.Password" class="text-danger small"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label asp-for="Register.ConfirmPassword" class="form-label fw-bold small text-muted">Confirm Password</label>
                                            <input asp-for="Register.ConfirmPassword" type="password" placeholder="Repeat your password" class="form-control form-control-lg rounded-3 ps-3" required />
                                            <span asp-validation-for="Register.ConfirmPassword" class="text-danger small"></span>
                                        </div>

                                        <div class="d-grid my-4">
                                            <button type="submit" class="btn btn-primary btn-lg rounded-pill py-3 fw-bold fs-5">Sign Up Now</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </section>
}
