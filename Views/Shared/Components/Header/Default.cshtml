@model PetShopApp.ViewModels.HeaderVM

<!-- Offcanvas Cart -->
<div class="offcanvas offcanvas-end" data-bs-scroll="true" tabindex="-1" id="offcanvasCart" aria-labelledby="My Cart">
  <div class="offcanvas-header justify-content-between border-bottom pb-3">
    <h5 class="offcanvas-title text-primary fw-bold" id="My Cart">Your Cart (@Model.CartItemCount)</h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body">
    @if (Model.CartItems.Any())
    {
      <div class="order-md-last">
        <ul class="list-group mb-3">
          @foreach (var item in Model.CartItems)
          {
            <li class="list-group-item d-flex justify-content-between align-items-center lh-sm py-3">
              <div class="d-flex align-items-center gap-3">
                <img src="~/images/@item.ImageUrl" alt="@item.ProductName" style="width: 50px; height: 50px; object-fit: cover;" class="rounded border" />
                <div>
                  <h6 class="my-0 fs-6">@item.ProductName</h6>
                  <small class="text-body-secondary">@item.Quantity x $@item.Price.ToString("F2")</small>
                </div>
              </div>
              <span class="text-primary fw-bold">$@item.TotalPrice.ToString("F2")</span>
            </li>
          }
          <li class="list-group-item d-flex justify-content-between align-items-center bg-light py-3">
            <span class="fw-bold">Total (USD)</span>
            <strong class="fs-5 text-primary">$@Model.CartSubTotal.ToString("F2")</strong>
          </li>
        </ul>

        <div class="d-grid gap-2">
          <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-dark btn-lg">View Cart</a>
          <a asp-controller="Checkout" asp-action="Index" class="btn btn-primary btn-lg">Continue to Checkout</a>
        </div>
      </div>
    }
    else
    {
      <div class="text-center py-5">
        <iconify-icon icon="mdi:cart-outline" class="fs-1 text-muted mb-3"></iconify-icon>
        <p class="text-muted">Your cart is currently empty.</p>
        <a asp-controller="Shop" asp-action="Index" class="btn btn-primary">Start Shopping</a>
      </div>
    }
  </div>
</div>

<!-- Offcanvas Search -->
<div class="offcanvas offcanvas-end" data-bs-scroll="true" tabindex="-1" id="offcanvasSearch" aria-labelledby="Search">
  <div class="offcanvas-header justify-content-between border-bottom pb-3">
    <h5 class="text-primary text-uppercase mb-0">Search Products</h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body">
    <div class="search-bar border rounded-2 border-dark-subtle p-2">
      <form class="text-center d-flex align-items-center" asp-controller="Shop" asp-action="Index" method="get">
        <input type="text" name="search" class="form-control border-0 bg-transparent" placeholder="Search products..." />
        <button type="submit" class="btn p-0 border-0 bg-transparent">
          <iconify-icon icon="tabler:search" class="fs-4 me-3 text-muted"></iconify-icon>
        </button>
      </form>
    </div>
  </div>
</div>

<!-- Header -->
<header>
  <div class="container py-2">
    <div class="row py-4 pb-0 pb-sm-4 align-items-center">

      <div class="col-sm-4 col-lg-3 text-center text-sm-start">
        <div class="main-logo">
          <a asp-controller="Home" asp-action="Index">
            <img src="~/images/@Model.LogoUrl" alt="@Model.SiteName" class="img-fluid" style="max-height: 50px;">
          </a>
        </div>
      </div>

      <div class="col-sm-6 offset-sm-2 offset-md-0 col-lg-5 d-none d-lg-block">
        <div class="search-bar border rounded-2 px-3 border-dark-subtle">
          <form class="text-center d-flex align-items-center" asp-controller="Shop" asp-action="Index" method="get">
            <input type="text" name="search" class="form-control border-0 bg-transparent" placeholder="Search for more than 10,000 products" />
            <button type="submit" class="btn p-0 border-0 bg-transparent">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                <path fill="currentColor"
                  d="M21.71 20.29L18 16.61A9 9 0 1 0 16.61 18l3.68 3.68a1 1 0 0 0 1.42 0a1 1 0 0 0 0-1.39ZM11 18a7 7 0 1 1 7-7a7 7 0 0 1-7 7Z" />
              </svg>
            </button>
          </form>
        </div>
      </div>

      <div class="col-sm-8 col-lg-4 d-flex justify-content-end gap-4 align-items-center mt-4 mt-sm-0 justify-content-center justify-content-sm-end">
        <div class="support-box text-end d-none d-xl-block">
          <span class="fs-6 secondary-font text-muted">Phone</span>
          <h5 class="mb-0">@Model.ContactPhone</h5>
        </div>
        <div class="support-box text-end d-none d-xl-block">
          <span class="fs-6 secondary-font text-muted">Email</span>
          <h5 class="mb-0">@Model.ContactEmail</h5>
        </div>
      </div>

    </div>
  </div>

  <div class="container-fluid">
    <hr class="m-0">
  </div>

  <div class="container">
    <nav class="main-menu d-flex navbar navbar-expand-lg">

      <!-- Mobile actions -->
      <div class="d-flex d-lg-none align-items-end mt-3">
        <ul class="d-flex justify-content-end list-unstyled m-0">
          <li>
            <a asp-controller="Account" asp-action="Index" class="mx-3">
              <iconify-icon icon="healthicons:person" class="fs-4"></iconify-icon>
            </a>
          </li>
          <li>
            <a asp-controller="Shop" asp-action="Wishlist" class="mx-3">
              <iconify-icon icon="mdi:heart" class="fs-4"></iconify-icon>
            </a>
          </li>
          <li>
            <a href="#" class="mx-3 position-relative" data-bs-toggle="offcanvas" data-bs-target="#offcanvasCart" aria-controls="offcanvasCart">
              <iconify-icon icon="mdi:cart" class="fs-4"></iconify-icon>
              <span class="position-absolute translate-middle badge rounded-circle bg-primary pt-1" style="top: 0; right: -10px;">
                @Model.CartItemCount
              </span>
            </a>
          </li>
          <li>
            <a href="#" class="mx-3" data-bs-toggle="offcanvas" data-bs-target="#offcanvasSearch" aria-controls="offcanvasSearch">
              <iconify-icon icon="tabler:search" class="fs-4"></iconify-icon>
            </a>
          </li>
        </ul>
      </div>

      <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar" aria-controls="offcanvasNavbar">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasNavbar" aria-labelledby="offcanvasNavbarLabel">

        <div class="offcanvas-header justify-content-center">
          <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>

        <div class="offcanvas-body justify-content-between">
          <select class="filter-categories border-0 mb-0 me-5" onchange="if(this.value) window.location.href=this.value;">
            <option value="">Shop by Category</option>
            @foreach (var cat in Model.Categories)
            {
              <option value="/Shop?category=@cat.Slug">@cat.Name</option>
            }
          </select>

          <ul class="navbar-nav menu-list list-unstyled d-flex gap-md-3 mb-0">
            <li class="nav-item">
              <a asp-controller="Home" asp-action="Index" class="nav-link">Home</a>
            </li>
            <li class="nav-item">
              <a asp-controller="Shop" asp-action="Index" class="nav-link">Shop</a>
            </li>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" role="button" id="pages" data-bs-toggle="dropdown" aria-expanded="false">Pages</a>
              <ul class="dropdown-menu" aria-labelledby="pages">
                <li><a asp-controller="Home" asp-action="About" class="dropdown-item">About Us</a></li>
                <li><a asp-controller="Shop" asp-action="Index" class="dropdown-item">Shop Catalog</a></li>
                <li><a asp-controller="Cart" asp-action="Index" class="dropdown-item">Shopping Cart</a></li>
                <li><a asp-controller="Shop" asp-action="Wishlist" class="dropdown-item">Wishlist</a></li>
                <li><a asp-controller="Checkout" asp-action="Index" class="dropdown-item">Checkout</a></li>
                <li><a asp-controller="Blog" asp-action="Index" class="dropdown-item">Blog</a></li>
                <li><a asp-controller="Contact" asp-action="Index" class="dropdown-item">Contact Us</a></li>
                <li><a asp-controller="Home" asp-action="Faqs" class="dropdown-item">FAQs</a></li>
                <li><a asp-controller="Account" asp-action="Index" class="dropdown-item">My Account</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a href="/scalar/v1" target="_blank" class="dropdown-item text-primary fw-bold"><i class="bi bi-file-code"></i> API Docs (Scalar)</a></li>
              </ul>
            </li>
            <li class="nav-item">
              <a asp-controller="Blog" asp-action="Index" class="nav-link">Blog</a>
            </li>
            <li class="nav-item">
              <a asp-controller="Contact" asp-action="Index" class="nav-link">Contact</a>
            </li>
          </ul>

          <div class="d-none d-lg-flex align-items-center">
            <ul class="d-flex justify-content-end list-unstyled m-0 align-items-center">
              <li>
                <a asp-controller="Account" asp-action="Index" class="mx-3 text-dark" title="Account">
                  <iconify-icon icon="healthicons:person" class="fs-4"></iconify-icon>
                </a>
              </li>
              <li>
                <a asp-controller="Shop" asp-action="Wishlist" class="mx-3 text-dark" title="Wishlist">
                  <iconify-icon icon="mdi:heart" class="fs-4"></iconify-icon>
                </a>
              </li>
              <li>
                <a href="#" class="mx-3 position-relative text-dark" data-bs-toggle="offcanvas" data-bs-target="#offcanvasCart" aria-controls="offcanvasCart" title="Cart">
                  <iconify-icon icon="mdi:cart" class="fs-4"></iconify-icon>
                  <span class="position-absolute translate-middle badge rounded-circle bg-primary pt-1" style="top: 0; right: -10px;">
                    @Model.CartItemCount
                  </span>
                </a>
              </li>
            </ul>
          </div>

        </div>

      </div>

    </nav>
  </div>
</header>
