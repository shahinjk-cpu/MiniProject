@model PetShopApp.ViewModels.FooterVM

<footer id="footer" class="my-5">
  <div class="container py-5 my-5">
    <div class="row">

      <div class="col-md-3">
        <div class="footer-menu">
          <img src="~/images/@Model.LogoUrl" alt="@Model.SiteName" style="max-height: 45px;">
          <p class="blog-paragraph fs-6 mt-3">Subscribe to our newsletter to get updates about our grand offers, new arrivals and pet care advice.</p>
          <div class="social-links">
            <ul class="d-flex list-unstyled gap-2">
              <li class="social">
                <a href="@Model.FacebookUrl" target="_blank">
                  <iconify-icon class="social-icon" icon="ri:facebook-fill"></iconify-icon>
                </a>
              </li>
              <li class="social">
                <a href="@Model.TwitterUrl" target="_blank">
                  <iconify-icon class="social-icon" icon="ri:twitter-fill"></iconify-icon>
                </a>
              </li>
              <li class="social">
                <a href="@Model.InstagramUrl" target="_blank">
                  <iconify-icon class="social-icon" icon="ri:instagram-fill"></iconify-icon>
                </a>
              </li>
              <li class="social">
                <a href="@Model.YouTubeUrl" target="_blank">
                  <iconify-icon class="social-icon" icon="ri:youtube-fill"></iconify-icon>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <div class="col-md-3">
        <div class="footer-menu">
          <h3>Quick Links</h3>
          <ul class="menu-list list-unstyled">
            <li class="menu-item"><a asp-controller="Home" asp-action="Index" class="nav-link">Home</a></li>
            <li class="menu-item"><a asp-controller="Home" asp-action="About" class="nav-link">About us</a></li>
            <li class="menu-item"><a asp-controller="Shop" asp-action="Index" class="nav-link">Shop Offer</a></li>
            <li class="menu-item"><a asp-controller="Blog" asp-action="Index" class="nav-link">Blog & News</a></li>
            <li class="menu-item"><a asp-controller="Contact" asp-action="Index" class="nav-link">Contact Us</a></li>
          </ul>
        </div>
      </div>

      <div class="col-md-3">
        <div class="footer-menu">
          <h3>Help Center</h3>
          <ul class="menu-list list-unstyled">
            <li class="menu-item"><a asp-controller="Home" asp-action="Faqs" class="nav-link">FAQs</a></li>
            <li class="menu-item"><a asp-controller="Checkout" asp-action="Index" class="nav-link">Checkout</a></li>
            <li class="menu-item"><a asp-controller="Cart" asp-action="Index" class="nav-link">Cart Details</a></li>
            <li class="menu-item"><a asp-controller="Shop" asp-action="Wishlist" class="nav-link">Wishlist</a></li>
            <li class="menu-item"><a asp-controller="Account" asp-action="Index" class="nav-link">My Account</a></li>
          </ul>
        </div>
      </div>

      <div class="col-md-3">
        <div>
          <h3>Our Newsletter</h3>
          <p class="blog-paragraph fs-6">Subscribe to our newsletter to get updates about our grand offers.</p>
          <div class="search-bar border rounded-pill border-dark-subtle px-2">
            <form class="text-center d-flex align-items-center" asp-controller="Home" asp-action="SubscribeNewsletter" method="post">
              <input type="email" name="email" class="form-control border-0 bg-transparent" placeholder="Enter your email here" required />
              <button type="submit" class="btn p-0 border-0 bg-transparent">
                <iconify-icon class="send-icon" icon="tabler:location-filled"></iconify-icon>
              </button>
            </form>
          </div>
        </div>
      </div>

    </div>
  </div>
</footer>

<div id="footer-bottom">
  <div class="container">
    <hr class="m-0">
    <div class="row mt-3">
      <div class="col-md-6 copyright">
        <p class="secondary-font">© @DateTime.UtcNow.Year @Model.SiteName. All rights reserved.</p>
      </div>
      <div class="col-md-6 text-md-end">
        <p class="secondary-font">Address: @Model.ContactAddress | Phone: @Model.ContactPhone</p>
      </div>
    </div>
  </div>
</div>
