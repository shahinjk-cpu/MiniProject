@model PetShopApp.ViewModels.ProductDetailVM
@{
    ViewData["Title"] = Model.Product.Name;
}

<!-- Banner / Breadcrumb -->
<section id="banner" class="py-3" style="background: #F9F3EC;">
  <div class="container">
    <div class="hero-content py-5 my-3">
      <h2 class="display-1 mt-3 mb-0">Product <span class="text-primary">Details</span></h2>
      <nav class="breadcrumb">
        <a class="breadcrumb-item nav-link" asp-controller="Home" asp-action="Index">Home</a>
        <a class="breadcrumb-item nav-link" asp-controller="Shop" asp-action="Index">Shop</a>
        <span class="breadcrumb-item active" aria-current="page">@Model.Product.Name</span>
      </nav>
    </div>
  </div>
</section>

<!-- Product Detail Main Section -->
<section id="selling-product">
  <div class="container my-md-5 py-5">
    <div class="row g-md-5">

      <!-- Gallery Column -->
      <div class="col-lg-6">
        <div class="row">
          <div class="col-md-12">
            <!-- Large Slider -->
            <div class="swiper product-large-slider rounded-4 shadow-sm overflow-hidden border">
              <div class="swiper-wrapper">
                <div class="swiper-slide text-center bg-light">
                  <img src="~/images/@Model.Product.MainImageUrl" alt="@Model.Product.Name" class="img-fluid" style="height: 480px; width: 100%; object-fit: contain;" />
                </div>
                @foreach (var img in Model.Product.Images.Where(i => !i.IsMain))
                {
                  <div class="swiper-slide text-center bg-light">
                    <img src="~/images/@img.ImageUrl" alt="@Model.Product.Name" class="img-fluid" style="height: 480px; width: 100%; object-fit: contain;" />
                  </div>
                }
              </div>
            </div>
          </div>

          <!-- Thumbnail Slider -->
          <div class="col-md-12 mt-3">
            <div thumbsSlider="" class="swiper product-thumbnail-slider">
              <div class="swiper-wrapper">
                <div class="swiper-slide border rounded-3 p-1 cursor-pointer">
                  <img src="~/images/@Model.Product.MainImageUrl" alt="@Model.Product.Name" class="img-fluid rounded" style="height: 90px; width: 100%; object-fit: cover;" />
                </div>
                @foreach (var img in Model.Product.Images.Where(i => !i.IsMain))
                {
                  <div class="swiper-slide border rounded-3 p-1 cursor-pointer">
                    <img src="~/images/@img.ImageUrl" alt="@Model.Product.Name" class="img-fluid rounded" style="height: 90px; width: 100%; object-fit: cover;" />
                  </div>
                }
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Info Column -->
      <div class="col-lg-6 mt-5 mt-lg-0">
        <div class="product-info">
          <div class="element-header">
            <h2 itemprop="name" class="display-6 fw-bold">@Model.Product.Name</h2>
            <div class="rating-container d-flex gap-2 align-items-center mt-2">
              <span class="rating secondary-font d-flex align-items-center gap-1">
                @for (int s = 1; s <= 5; s++)
                {
                  if (s <= Math.Round(Model.Product.Rating))
                  {
                    <iconify-icon icon="clarity:star-solid" class="text-primary fs-5"></iconify-icon>
                  }
                  else
                  {
                    <iconify-icon icon="clarity:star-line" class="text-muted fs-5"></iconify-icon>
                  }
                }
              </span>
              <span class="fw-bold ms-1">@Model.Product.Rating.ToString("F1")</span>
              <span class="text-muted small">(@Model.Product.ReviewCount customer reviews)</span>
            </div>
          </div>

          <div class="product-price pt-3 pb-3 d-flex align-items-baseline gap-3">
            <strong class="text-primary display-6 fw-bold">$@Model.Product.Price.ToString("F2")</strong>
            @if (Model.Product.OldPrice.HasValue)
            {
              <del class="text-muted fs-4">$@Model.Product.OldPrice.Value.ToString("F2")</del>
            }
          </div>

          <p class="fs-5 text-secondary">@Model.Product.Description</p>

          <div class="cart-wrap pt-2">
            <div class="product-quantity pt-2">
              <div class="stock-number text-dark mb-2">
                @if (Model.Product.StockQuantity > 0)
                {
                  <span class="badge bg-success-subtle text-success fs-6"><i class="bi bi-check-circle"></i> @Model.Product.StockQuantity in stock</span>
                }
                else
                {
                  <span class="badge bg-danger-subtle text-danger fs-6">Out of stock</span>
                }
              </div>

              <!-- Add to Cart Form -->
              <form asp-controller="Cart" asp-action="AddToCart" method="post">
                <input type="hidden" name="productId" value="@Model.Product.Id" />
                <div class="stock-button-wrap d-flex align-items-center gap-3">
                  <div class="input-group product-qty align-items-center" style="max-width: 140px;">
                    <span class="input-group-btn">
                      <button type="button" class="quantity-left-minus btn btn-light border btn-number" data-type="minus">
                        <svg width="16" height="16"><use xlink:href="#minus"></use></svg>
                      </button>
                    </span>
                    <input type="number" id="quantity" name="quantity" class="form-control input-number text-center p-2 mx-1 border" value="1" min="1" max="@Model.Product.StockQuantity">
                    <span class="input-group-btn">
                      <button type="button" class="quantity-right-plus btn btn-light border btn-number" data-type="plus">
                        <svg width="16" height="16"><use xlink:href="#plus"></use></svg>
                      </button>
                    </span>
                  </div>

                  <button type="submit" class="btn btn-primary btn-lg px-4 py-3 text-uppercase fw-bold">
                    Add to Cart
                  </button>

                  <a asp-action="AddToWishlist" asp-route-productId="@Model.Product.Id" class="btn btn-outline-dark btn-lg p-3" title="Add to Wishlist">
                    <iconify-icon icon="fluent:heart-28-filled" class="fs-4 text-danger"></iconify-icon>
                  </a>
                </div>
              </form>
            </div>
          </div>

          <div class="meta-product pt-4 border-top mt-4">
            <div class="meta-item d-flex align-items-baseline mb-2">
              <h6 class="item-title fw-bold pe-2 mb-0">SKU:</h6>
              <span class="text-secondary">@Model.Product.SKU</span>
            </div>
            <div class="meta-item d-flex align-items-baseline mb-2">
              <h6 class="item-title fw-bold pe-2 mb-0">Category:</h6>
              <a asp-action="Index" asp-route-category="@Model.Product.Category?.Slug" class="text-primary text-decoration-none">
                @Model.Product.Category?.Name
              </a>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<!-- Tabs: Description, Additional Info, Reviews -->
<section class="product-info-tabs py-md-5 bg-light">
  <div class="container py-5">
    <div class="row">
      <div class="d-flex flex-column flex-md-row align-items-start gap-5">

        <div class="nav flex-row flex-wrap flex-md-column nav-pills me-3 col-lg-3" id="v-pills-tab" role="tablist" aria-orientation="vertical">
          <button class="nav-link fs-5 mb-2 text-start active" id="v-pills-description-tab" data-bs-toggle="pill" data-bs-target="#v-pills-description" type="button" role="tab" aria-controls="v-pills-description" aria-selected="true">
            Description
          </button>
          <button class="nav-link fs-5 mb-2 text-start" id="v-pills-additional-tab" data-bs-toggle="pill" data-bs-target="#v-pills-additional" type="button" role="tab" aria-controls="v-pills-additional" aria-selected="false">
            Additional Information
          </button>
          <button class="nav-link fs-5 mb-2 text-start" id="v-pills-reviews-tab" data-bs-toggle="pill" data-bs-target="#v-pills-reviews" type="button" role="tab" aria-controls="v-pills-reviews" aria-selected="false">
            Customer Reviews (@Model.Product.Reviews.Count)
          </button>
        </div>

        <div class="tab-content col-lg-8 bg-white p-5 rounded-4 shadow-sm" id="v-pills-tabContent">
          <!-- Description -->
          <div class="tab-pane fade show active" id="v-pills-description" role="tabpanel" aria-labelledby="v-pills-description-tab">
            <h3 class="fw-bold mb-3">Product Description</h3>
            <p class="fs-6 text-secondary lh-lg">@Model.Product.Description</p>
            <h5 class="fw-bold mt-4 mb-2">Key Highlights:</h5>
            <ul class="text-secondary ps-4">
              <li class="py-1">Veterinarian approved and safe for all domestic pets.</li>
              <li class="py-1">Made from eco-friendly and non-toxic high durability materials.</li>
              <li class="py-1">Guaranteed comfort, satisfaction, and longevity.</li>
            </ul>
          </div>

          <!-- Additional Info -->
          <div class="tab-pane fade" id="v-pills-additional" role="tabpanel" aria-labelledby="v-pills-additional-tab">
            <h3 class="fw-bold mb-3">Specifications & Usage</h3>
            <p class="fs-6 text-secondary lh-lg">@(string.IsNullOrEmpty(Model.Product.AdditionalInfo) ? "Standard commercial pet sizing and care guidelines apply." : Model.Product.AdditionalInfo)</p>
          </div>

          <!-- Reviews -->
          <div class="tab-pane fade" id="v-pills-reviews" role="tabpanel" aria-labelledby="v-pills-reviews-tab">
            <h3 class="fw-bold mb-4">Customer Reviews</h3>
            @if (!Model.Product.Reviews.Any())
            {
              <p class="text-muted fst-italic">No reviews yet for this product. Be the first to share your experience!</p>
            }
            else
            {
              <div class="review-box d-flex flex-column gap-4">
                @foreach (var rev in Model.Product.Reviews.OrderByDescending(r => r.CreatedAt))
                {
                  <div class="d-flex gap-3 pb-3 border-bottom">
                    <div class="avatar bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold fs-4" style="width: 50px; height: 50px;">
                      @rev.FullName.FirstOrDefault()
                    </div>
                    <div class="review-content flex-grow-1">
                      <div class="d-flex justify-content-between align-items-center mb-1">
                        <h5 class="m-0 fw-bold">@rev.FullName</h5>
                        <span class="text-muted small">@rev.CreatedAt.ToString("MMM dd, yyyy")</span>
                      </div>
                      <div class="rating-container text-primary mb-2">
                        @for (int r = 1; r <= rev.Rating; r++)
                        {
                          <iconify-icon icon="clarity:star-solid"></iconify-icon>
                        }
                      </div>
                      <p class="text-secondary mb-0">@rev.Comment</p>
                    </div>
                  </div>
                }
              </div>
            }

            <!-- Add Review Form -->
            <div class="add-review mt-5 pt-4 border-top">
              <h4 class="fw-bold mb-2">Add a Review</h4>
              <p class="text-muted small mb-4">Your feedback helps fellow pet owners make informed choices.</p>
              <form asp-action="AddReview" method="post">
                <input type="hidden" name="productId" value="@Model.Product.Id" />
                <div class="row g-3">
                  <div class="col-md-6">
                    <label class="form-label fw-bold">Your Name *</label>
                    <input type="text" name="fullName" class="form-control p-3" placeholder="John Doe" required />
                  </div>
                  <div class="col-md-6">
                    <label class="form-label fw-bold">Your Email *</label>
                    <input type="email" name="email" class="form-control p-3" placeholder="john@example.com" required />
                  </div>
                  <div class="col-md-12">
                    <label class="form-label fw-bold">Rating (1 to 5 Stars) *</label>
                    <select name="rating" class="form-select p-3">
                      <option value="5">★★★★★ - 5 Stars (Excellent)</option>
                      <option value="4">★★★★☆ - 4 Stars (Good)</option>
                      <option value="3">★★★☆☆ - 3 Stars (Average)</option>
                      <option value="2">★★☆☆☆ - 2 Stars (Poor)</option>
                      <option value="1">★☆☆☆☆ - 1 Star (Very Bad)</option>
                    </select>
                  </div>
                  <div class="col-md-12">
                    <label class="form-label fw-bold">Your Review *</label>
                    <textarea name="comment" rows="4" class="form-control p-3" placeholder="Write your honest review here..." required></textarea>
                  </div>
                  <div class="col-12">
                    <button type="submit" class="btn btn-dark btn-lg px-5 py-3 text-uppercase">Submit Review</button>
                  </div>
                </div>
              </form>
            </div>
          </div>

        </div>

      </div>
    </div>
  </div>
</section>

<!-- Related Products Carousel -->
@if (Model.RelatedProducts.Any())
{
  <section class="py-5 my-5 overflow-hidden">
    <div class="container">
      <div class="section-header d-flex justify-content-between align-items-center mb-4">
        <h2 class="display-5 fw-normal">Related Products</h2>
        <a asp-action="Index" class="btn btn-outline-dark text-uppercase fs-6">View All</a>
      </div>

      <div class="row">
        @foreach (var rel in Model.RelatedProducts)
        {
          <div class="col-md-3 col-sm-6 mb-4">
            <div class="card position-relative h-100 border-0 shadow-sm rounded-4 p-3">
              <a asp-action="Detail" asp-route-slug="@rel.Slug" class="text-center d-block">
                <img src="~/images/@rel.MainImageUrl" class="img-fluid rounded-4" alt="@rel.Name" style="height: 200px; width: 100%; object-fit: cover;">
              </a>
              <div class="card-body p-0 pt-3">
                <a asp-action="Detail" asp-route-slug="@rel.Slug" class="text-decoration-none text-dark">
                  <h3 class="card-title fs-6 m-0 text-truncate">@rel.Name</h3>
                </a>
                <div class="d-flex align-items-baseline gap-2 mt-2">
                  <h4 class="secondary-font text-primary fs-5 m-0">$@rel.Price.ToString("F2")</h4>
                  @if (rel.OldPrice.HasValue)
                  {
                    <span class="text-muted text-decoration-line-through small">$@rel.OldPrice.Value.ToString("F2")</span>
                  }
                </div>
              </div>
            </div>
          </div>
        }
      </div>
    </div>
  </section>
}
