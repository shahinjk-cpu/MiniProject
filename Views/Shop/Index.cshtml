@model PetShopApp.ViewModels.ShopVM
@{
    ViewData["Title"] = "Shop Catalog";
}

<!-- Banner / Breadcrumb -->
<section id="banner" class="py-3" style="background: #F9F3EC;">
  <div class="container">
    <div class="hero-content py-5 my-3">
      <h2 class="display-1 mt-3 mb-0">Shop</h2>
      <nav class="breadcrumb">
        <a class="breadcrumb-item nav-link" asp-controller="Home" asp-action="Index">Home</a>
        <a class="breadcrumb-item nav-link" asp-controller="Shop" asp-action="Index">Catalog</a>
        <span class="breadcrumb-item active" aria-current="page">
          @(string.IsNullOrEmpty(Model.SelectedCategory) ? "All Products" : Model.SelectedCategory)
        </span>
      </nav>
    </div>
  </div>
</section>

<!-- Shop Main Grid & Sidebar -->
<div class="shopify-grid">
  <div class="container py-5 my-5">
    <div class="row flex-md-row-reverse g-md-5 mb-5">

      <main class="col-md-9">
        <div class="filter-shop d-md-flex justify-content-between align-items-center mb-4">
          <div class="showing-product">
            <p class="m-0 text-muted">Showing @Model.ShowingFrom–@Model.ShowingTo of @Model.TotalItems results</p>
          </div>
          <div class="sort-by">
            <select class="filter-categories border rounded px-3 py-2 m-0 bg-transparent" onchange="changeSort(this.value)">
              <option value="" selected="@(string.IsNullOrEmpty(Model.SortOrder))">Default sorting</option>
              <option value="name_asc" selected="@(Model.SortOrder == "name_asc")">Name (A - Z)</option>
              <option value="name_desc" selected="@(Model.SortOrder == "name_desc")">Name (Z - A)</option>
              <option value="price_asc" selected="@(Model.SortOrder == "price_asc")">Price (Low - High)</option>
              <option value="price_desc" selected="@(Model.SortOrder == "price_desc")">Price (High - Low)</option>
              <option value="rating_desc" selected="@(Model.SortOrder == "rating_desc")">Rating (Highest)</option>
            </select>
          </div>
        </div>

        @if (!Model.Products.Any())
        {
          <div class="text-center py-5">
            <iconify-icon icon="tabler:mood-empty" class="fs-1 text-muted mb-3"></iconify-icon>
            <h3 class="fw-normal text-muted">No products found matching your criteria.</h3>
            <p class="text-muted">Try clearing some filters or searching with different keywords.</p>
            <a asp-action="Index" class="btn btn-outline-primary mt-2">Reset All Filters</a>
          </div>
        }
        else
        {
          <div class="product-grid row">
            @foreach (var item in Model.Products)
            {
              <div class="col-md-4 my-4">
                <div class="card position-relative h-100 border-0 shadow-sm rounded-4 p-3">
                  @if (item.OldPrice.HasValue && item.OldPrice > item.Price)
                  {
                    <div class="z-1 position-absolute rounded-3 m-3 px-3 border border-dark-subtle bg-white text-danger fw-bold">
                      Sale
                    </div>
                  }
                  else if (item.IsFeatured)
                  {
                    <div class="z-1 position-absolute rounded-3 m-3 px-3 border border-dark-subtle bg-white text-primary">
                      New
                    </div>
                  }

                  <a asp-action="Detail" asp-route-slug="@item.Slug" class="text-center d-block">
                    <img src="~/images/@item.MainImageUrl" class="img-fluid rounded-4" alt="@item.Name" style="height: 230px; width: 100%; object-fit: cover;">
                  </a>

                  <div class="card-body p-0 pt-3">
                    <a asp-action="Detail" asp-route-slug="@item.Slug" class="text-decoration-none text-dark">
                      <h3 class="card-title fs-5 m-0 text-truncate" title="@item.Name">@item.Name</h3>
                    </a>

                    <div class="card-text mt-2">
                      <span class="rating secondary-font d-flex align-items-center gap-1 mb-2">
                        <iconify-icon icon="clarity:star-solid" class="text-primary"></iconify-icon>
                        <span class="ms-1">@item.Rating.ToString("F1")</span>
                        <span class="text-muted small">(@item.ReviewCount)</span>
                      </span>

                      <div class="d-flex align-items-baseline gap-2">
                        @if (item.OldPrice.HasValue)
                        {
                          <span class="text-muted text-decoration-line-through fs-6">$@item.OldPrice.Value.ToString("F2")</span>
                        }
                        <h3 class="secondary-font text-primary fs-4 m-0">$@item.Price.ToString("F2")</h3>
                      </div>

                      <div class="d-flex flex-wrap mt-3">
                        <a asp-controller="Cart" asp-action="AddToCart" asp-route-productId="@item.Id" class="btn-cart me-3 px-4 pt-3 pb-3 text-decoration-none">
                          <h5 class="text-uppercase m-0 fs-6">Add to Cart</h5>
                        </a>
                        <a asp-action="AddToWishlist" asp-route-productId="@item.Id" class="btn-wishlist px-4 pt-3 text-decoration-none" title="Wishlist">
                          <iconify-icon icon="fluent:heart-28-filled" class="fs-5"></iconify-icon>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            }
          </div>

          <!-- Pagination -->
          @if (Model.TotalPages > 1)
          {
            <nav class="navigation paging-navigation text-center mt-5" role="navigation">
              <div class="pagination loop-pagination d-flex justify-content-center align-items-center">
                @if (Model.CurrentPage > 1)
                {
                  <a class="pagination-arrow d-flex align-items-center mx-3" href="@Url.Action("Index", new { page = Model.CurrentPage - 1, category = Model.SelectedCategory, search = Model.SearchQuery, sort = Model.SortOrder, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice })">
                    <iconify-icon icon="ic:baseline-keyboard-arrow-left" class="pagination-arrow fs-1"></iconify-icon>
                  </a>
                }

                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                  if (p == Model.CurrentPage)
                  {
                    <span aria-current="page" class="page-numbers mt-2 fs-4 mx-2 px-3 py-1 bg-primary text-white rounded-circle current">@p</span>
                  }
                  else
                  {
                    <a class="page-numbers mt-2 fs-4 mx-2 px-3 py-1 text-dark text-decoration-none" href="@Url.Action("Index", new { page = p, category = Model.SelectedCategory, search = Model.SearchQuery, sort = Model.SortOrder, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice })">@p</a>
                  }
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                  <a class="pagination-arrow d-flex align-items-center mx-3" href="@Url.Action("Index", new { page = Model.CurrentPage + 1, category = Model.SelectedCategory, search = Model.SearchQuery, sort = Model.SortOrder, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice })">
                    <iconify-icon icon="ic:baseline-keyboard-arrow-right" class="pagination-arrow fs-1"></iconify-icon>
                  </a>
                }
              </div>
            </nav>
          }
        }
      </main>

      <!-- Sidebar -->
      <aside class="col-md-3 mt-5 mt-md-0">
        <div class="sidebar">

          <!-- Search Widget -->
          <div class="widget-menu mb-4">
            <div class="widget-search-bar">
              <div class="search-bar border rounded-2 border-dark-subtle p-2">
                <form id="search-form" class="text-center d-flex align-items-center" asp-action="Index" method="get">
                  <input type="hidden" name="category" value="@Model.SelectedCategory" />
                  <input type="hidden" name="sort" value="@Model.SortOrder" />
                  <input type="text" name="search" value="@Model.SearchQuery" class="form-control border-0 bg-transparent" placeholder="Search products..." />
                  <button type="submit" class="btn p-0 border-0 bg-transparent">
                    <iconify-icon icon="tabler:search" class="fs-4 text-muted"></iconify-icon>
                  </button>
                </form>
              </div>
            </div>
          </div>

          <!-- Categories Widget -->
          <div class="widget-product-categories pt-4">
            <h4 class="widget-title fw-bold mb-3">Categories</h4>
            <ul class="product-categories sidebar-list list-unstyled">
              <li class="cat-item py-1">
                <a asp-action="Index" class="nav-link @(string.IsNullOrEmpty(Model.SelectedCategory) ? "fw-bold text-primary" : "")">
                  All Categories
                </a>
              </li>
              @foreach (var c in Model.Categories)
              {
                <li class="cat-item py-1 d-flex justify-content-between align-items-center">
                  <a asp-action="Index" asp-route-category="@c.Slug" asp-route-sort="@Model.SortOrder" class="nav-link @(Model.SelectedCategory == c.Slug ? "fw-bold text-primary" : "")">
                    @c.Name
                  </a>
                  <span class="badge bg-light text-muted border rounded-pill">@c.Products.Count</span>
                </li>
              }
            </ul>
          </div>

          <!-- Price Filter Widget -->
          <div class="widget-price-filter pt-4">
            <h4 class="widget-title fw-bold mb-3">Filter By Price</h4>
            <ul class="product-tags sidebar-list list-unstyled">
              <li class="tags-item py-1">
                <a asp-action="Index" asp-route-category="@Model.SelectedCategory" asp-route-sort="@Model.SortOrder" class="nav-link @(!Model.MinPrice.HasValue && !Model.MaxPrice.HasValue ? "fw-bold text-primary" : "")">
                  All Prices
                </a>
              </li>
              <li class="tags-item py-1">
                <a asp-action="Index" asp-route-category="@Model.SelectedCategory" asp-route-sort="@Model.SortOrder" asp-route-maxPrice="25" class="nav-link @(Model.MaxPrice == 25 && !Model.MinPrice.HasValue ? "fw-bold text-primary" : "")">
                  Under $25
                </a>
              </li>
              <li class="tags-item py-1">
                <a asp-action="Index" asp-route-category="@Model.SelectedCategory" asp-route-sort="@Model.SortOrder" asp-route-minPrice="25" asp-route-maxPrice="45" class="nav-link @(Model.MinPrice == 25 && Model.MaxPrice == 45 ? "fw-bold text-primary" : "")">
                  $25 - $45
                </a>
              </li>
              <li class="tags-item py-1">
                <a asp-action="Index" asp-route-category="@Model.SelectedCategory" asp-route-sort="@Model.SortOrder" asp-route-minPrice="45" asp-route-maxPrice="70" class="nav-link @(Model.MinPrice == 45 && Model.MaxPrice == 70 ? "fw-bold text-primary" : "")">
                  $45 - $70
                </a>
              </li>
              <li class="tags-item py-1">
                <a asp-action="Index" asp-route-category="@Model.SelectedCategory" asp-route-sort="@Model.SortOrder" asp-route-minPrice="70" class="nav-link @(Model.MinPrice == 70 && !Model.MaxPrice.HasValue ? "fw-bold text-primary" : "")">
                  $70 and Above
                </a>
              </li>
            </ul>
          </div>

          @if (!string.IsNullOrEmpty(Model.SelectedCategory) || !string.IsNullOrEmpty(Model.SearchQuery) || Model.MinPrice.HasValue || Model.MaxPrice.HasValue)
          {
            <div class="pt-4">
              <a asp-action="Index" class="btn btn-outline-danger w-100 btn-sm">Clear Filters</a>
            </div>
          }

        </div>
      </aside>

    </div>
  </div>
</div>

@section Scripts {
  <script>
    function changeSort(val) {
      const url = new URL(window.location.href);
      if (val) {
        url.searchParams.set('sort', val);
      } else {
        url.searchParams.delete('sort');
      }
      url.searchParams.set('page', '1');
      window.location.href = url.toString();
    }
  </script>
}
