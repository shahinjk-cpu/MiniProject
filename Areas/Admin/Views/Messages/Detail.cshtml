@model PetShopApp.Models.ContactMessage
@{
    ViewData["Title"] = $"Inquiry: {Model.Subject}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold text-dark m-0">Inquiry Details</h4>
        <small class="text-muted">Received on @Model.CreatedAt.ToString("f")</small>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="bi bi-arrow-left me-1"></i> Back to Messages
    </a>
</div>

<div class="row g-4">
    <!-- Message Content -->
    <div class="col-lg-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold m-0 text-dark">Subject: @Model.Subject</h5>
                <span class="badge bg-success px-3 py-2 rounded-pill">Read</span>
            </div>
            <div class="card-body p-4">
                <p class="fs-5 text-dark" style="white-space: pre-line; line-height: 1.8;">
                    @Model.Message
                </p>

                <div class="border-top pt-4 mt-4 d-flex gap-2">
                    <a href="mailto:@Model.Email?subject=Re: @Uri.EscapeDataString(Model.Subject)" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-reply me-1"></i> Reply via Email
                    </a>
                    <a href="tel:@Model.Phone" class="btn btn-outline-dark rounded-pill px-4">
                        <i class="bi bi-telephone me-1"></i> Call Customer
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Sender Sidebar -->
    <div class="col-lg-4">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold m-0 text-dark"><i class="bi bi-person-circle me-2"></i>Sender Info</h5>
            </div>
            <div class="card-body">
                <p class="mb-2"><strong>Name:</strong> @Model.FullName</p>
                <p class="mb-2"><strong>Email:</strong> <a href="mailto:@Model.Email">@Model.Email</a></p>
                <p class="mb-2"><strong>Phone:</strong> <a href="tel:@Model.Phone">@Model.Phone</a></p>
                <p class="mb-0 text-muted small"><strong>Sent at:</strong> @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm:ss")</p>
            </div>
        </div>

        <div class="card shadow-sm p-3">
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Bu müraciəti birdəfəlik silmək istəyirsiniz?');">
                <button type="submit" class="btn btn-outline-danger w-100 rounded-pill py-2">
                    <i class="bi bi-trash me-1"></i> Delete Inquiry
                </button>
            </form>
        </div>
    </div>
</div>
