@model PetShopApp.Areas.Admin.ViewModels.DashboardVM
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Stat Cards -->
<div class="row g-4 mb-4">
    <div class="col-xl-3 col-sm-6">
        <div class="card p-3 shadow-sm h-100 border-start border-primary border-4">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-bold small text-uppercase">Total Revenue</span>
                    <h2 class="fw-bold text-dark mt-2 mb-0">$@Model.TotalRevenue.ToString("N2")</h2>
                </div>
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle fs-3">
                    <i class="bi bi-currency-dollar"></i>
                </div>
            </div>
            <small class="text-success mt-3"><i class="bi bi-arrow-up"></i> All completed/active orders</small>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="card p-3 shadow-sm h-100 border-start border-info border-4">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-bold small text-uppercase">Total Orders</span>
                    <h2 class="fw-bold text-dark mt-2 mb-0">@Model.TotalOrders</h2>
                </div>
                <div class="bg-info bg-opacity-10 text-info p-3 rounded-circle fs-3">
                    <i class="bi bi-cart-check"></i>
                </div>
            </div>
            <div class="mt-3">
                <span class="badge bg-warning text-dark px-2 py-1">@Model.PendingOrdersCount pending</span>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="card p-3 shadow-sm h-100 border-start border-success border-4">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-bold small text-uppercase">Catalog Products</span>
                    <h2 class="fw-bold text-dark mt-2 mb-0">@Model.TotalProducts</h2>
                </div>
                <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle fs-3">
                    <i class="bi bi-box-seam"></i>
                </div>
            </div>
            <small class="text-muted mt-3">Across @Model.TotalCategories active categories</small>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="card p-3 shadow-sm h-100 border-start border-warning border-4">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-bold small text-uppercase">Messages</span>
                    <h2 class="fw-bold text-dark mt-2 mb-0">@Model.UnreadMessagesCount</h2>
                </div>
                <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle fs-3">
                    <i class="bi bi-envelope"></i>
                </div>
            </div>
            <small class="text-danger mt-3">Unread customer inquiries</small>
        </div>
    </div>
</div>

<!-- Quick Shortcuts -->
<div class="card p-3 mb-4 shadow-sm bg-white">
    <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
        <div class="fw-bold text-dark"><i class="bi bi-lightning-charge me-1 text-warning"></i> Quick Management Actions:</div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Products" asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3">
                <i class="bi bi-plus-circle me-1"></i> New Product
            </a>
            <a asp-controller="Categories" asp-action="Create" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                <i class="bi bi-plus-circle me-1"></i> New Category
            </a>
            <a asp-controller="Orders" asp-action="Index" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                <i class="bi bi-receipt me-1"></i> Manage Orders
            </a>
            <a asp-controller="Messages" asp-action="Index" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                <i class="bi bi-chat-dots me-1"></i> Customer Inquiries
            </a>
            <a href="/scalar/v1" target="_blank" class="btn btn-outline-info btn-sm rounded-pill px-3">
                <i class="bi bi-code-square me-1"></i> Scalar API Docs
            </a>
        </div>
    </div>
</div>

<!-- Tables Section -->
<div class="row g-4">
    <!-- Recent Orders -->
    <div class="col-lg-8">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold m-0 text-dark"><i class="bi bi-clock-history me-2"></i>Recent Orders</h5>
                <a asp-controller="Orders" asp-action="Index" class="btn btn-link btn-sm text-decoration-none p-0 fw-bold">View All &rarr;</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.RecentOrders.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-bag-x fs-1 d-block mb-2"></i>
                        No orders recorded yet.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Order #</th>
                                    <th>Customer</th>
                                    <th>Total</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model.RecentOrders)
                                {
                                    <tr>
                                        <td class="fw-bold text-primary">@order.OrderCode</td>
                                        <td>@order.FirstName @order.LastName</td>
                                        <td class="fw-bold">$@order.TotalAmount.ToString("N2")</td>
                                        <td>
                                            @switch (order.Status)
                                            {
                                                case OrderStatus.Pending:
                                                    <span class="badge badge-pending px-2 py-1 rounded-pill">Pending</span>
                                                    break;
                                                case OrderStatus.Processing:
                                                    <span class="badge badge-processing px-2 py-1 rounded-pill">Processing</span>
                                                    break;
                                                case OrderStatus.Shipped:
                                                    <span class="badge badge-shipped px-2 py-1 rounded-pill">Shipped</span>
                                                    break;
                                                case OrderStatus.Delivered:
                                                    <span class="badge badge-delivered px-2 py-1 rounded-pill">Delivered</span>
                                                    break;
                                                case OrderStatus.Cancelled:
                                                    <span class="badge badge-cancelled px-2 py-1 rounded-pill">Cancelled</span>
                                                    break;
                                            }
                                        </td>
                                        <td class="text-muted small">@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                        <td class="text-end">
                                            <a asp-controller="Orders" asp-action="Detail" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                                Details
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Low Stock Alerts -->
    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold m-0 text-dark"><i class="bi bi-exclamation-diamond text-danger me-2"></i>Low Stock Alert</h5>
                <span class="badge bg-danger rounded-pill">@Model.LowStockProducts.Count</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.LowStockProducts.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-check-circle fs-1 text-success d-block mb-2"></i>
                        All inventory is well-stocked!
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var prod in Model.LowStockProducts)
                        {
                            <li class="list-group-item d-flex align-items-center justify-content-between py-3">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="~/@prod.MainImageUrl" alt="@prod.Name" class="rounded border" style="width: 45px; height: 45px; object-fit: cover;" />
                                    <div>
                                        <h6 class="mb-0 fs-6 fw-bold text-dark">@prod.Name</h6>
                                        <small class="text-muted">@prod.Category?.Name</small>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-danger rounded-pill">@prod.StockQuantity left</span>
                                    <div>
                                        <a asp-controller="Products" asp-action="Edit" asp-route-id="@prod.Id" class="small text-decoration-none">Edit</a>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
