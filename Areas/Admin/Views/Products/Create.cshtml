@model PetShopApp.Areas.Admin.ViewModels.ProductFormVM
@{
    ViewData["Title"] = "Add New Product";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold m-0 text-dark">Create New Product</h5>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="bi bi-arrow-left me-1"></i> Back to List
                </a>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label asp-for="Name" class="form-label fw-bold">Product Name *</label>
                            <input asp-for="Name" class="form-control form-control-lg rounded-3" placeholder="e.g. Grey Warm Dog Hoodie" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SKU" class="form-label fw-bold">SKU Code *</label>
                            <input asp-for="SKU" class="form-control form-control-lg rounded-3" placeholder="WAG-CLO-099" required />
                            <span asp-validation-for="SKU" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="CategoryId" class="form-label fw-bold">Category *</label>
                            <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="form-select rounded-3">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Price" class="form-label fw-bold">Regular Price ($) *</label>
                            <input asp-for="Price" type="number" step="0.01" class="form-control rounded-3" placeholder="25.00" required />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="OldPrice" class="form-label fw-bold">Old / Original Price ($)</label>
                            <input asp-for="OldPrice" type="number" step="0.01" class="form-control rounded-3" placeholder="30.00" />
                            <small class="text-muted">Displays discount cross-out</small>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="StockQuantity" class="form-label fw-bold">Stock Quantity *</label>
                            <input asp-for="StockQuantity" type="number" class="form-control rounded-3" value="15" required />
                            <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="MainImageUrl" class="form-label fw-bold">Main Image Path</label>
                            <div class="input-group">
                                <input asp-for="MainImageUrl" class="form-control rounded-start-3" id="imgInput" placeholder="images/item1.jpg" />
                                <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">Template Images</button>
                                <ul class="dropdown-menu dropdown-menu-end" style="max-height: 250px; overflow-y: auto;">
                                    @for (int i = 1; i <= 16; i++)
                                    {
                                        string path = $"images/item{i}.jpg";
                                        <li><a class="dropdown-item" href="javascript:void(0);" onclick="document.getElementById('imgInput').value='@path';">@path</a></li>
                                    }
                                </ul>
                            </div>
                            <small class="text-muted">Select an existing template image or provide custom image path.</small>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-bold">Short Description</label>
                        <textarea asp-for="Description" class="form-control rounded-3" rows="3" placeholder="A brief, engaging summary of the item..."></textarea>
                    </div>

                    <div class="mb-4">
                        <label asp-for="AdditionalInfo" class="form-label fw-bold">Additional Specifications & Details</label>
                        <textarea asp-for="AdditionalInfo" class="form-control rounded-3" rows="4" placeholder="Materials, dimensions, care instructions, etc."></textarea>
                    </div>

                    <!-- Filter Badges & Flags -->
                    <div class="p-3 bg-light rounded-4 mb-4">
                        <h6 class="fw-bold mb-3 text-dark"><i class="bi bi-toggles me-1"></i> Product Tags &amp; Placement</h6>
                        <div class="row g-3">
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input asp-for="IsClothing" class="form-check-input" type="checkbox" id="isClothing">
                                    <label class="form-check-label fw-bold" for="isClothing">Clothing Item</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input asp-for="IsFoodie" class="form-check-input" type="checkbox" id="isFoodie">
                                    <label class="form-check-label fw-bold" for="isFoodie">Foodie Item</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input asp-for="IsBestSeller" class="form-check-input" type="checkbox" id="isBestSeller">
                                    <label class="form-check-label fw-bold" for="isBestSeller">Best Seller</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActive" checked>
                                    <label class="form-check-label fw-bold" for="isActive">Active (Published)</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary rounded-pill px-5 py-2">
                            <i class="bi bi-check2-circle me-1"></i> Save Product
                        </button>
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4 py-2 border">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
