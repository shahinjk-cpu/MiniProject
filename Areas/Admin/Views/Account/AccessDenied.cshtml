@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 my-5 text-center">
    <div class="col-md-6 offset-md-3">
        <div class="card p-5 shadow-sm rounded-5 border-0">
            <i class="bi bi-shield-slash text-danger display-1 mb-3"></i>
            <h2 class="fw-bold text-dark">Giriş Qadağandır (403)</h2>
            <p class="text-muted fs-5 my-3">
                Bu səhifə yalnız Administratorlar üçün nəzərdə tutulub. Sizin bu panelə daxil olmaq hüququnuz yoxdur.
            </p>
            <div class="d-flex justify-content-center gap-3 mt-3">
                <a asp-action="Login" class="btn btn-primary rounded-pill px-4">Admin Girişi</a>
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-dark rounded-pill px-4">Əsas Səhifə</a>
            </div>
        </div>
    </div>
</div>
