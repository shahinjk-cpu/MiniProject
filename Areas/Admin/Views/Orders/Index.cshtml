@model IEnumerable<PetShopApp.Models.Order>
@{
    ViewData["Title"] = "Customer Orders";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    OrderStatus? selectedStatus = ViewBag.SelectedStatus;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold text-dark m-0">Customer Orders</h4>
        <small class="text-muted">Total: @ViewBag.TotalCount orders placed</small>
    </div>
</div>

<!-- Status Filters -->
<div class="card shadow-sm p-3 mb-4 bg-white">
    <div class="d-flex flex-wrap gap-2 align-items-center">
        <span class="fw-bold me-2 text-muted small text-uppercase">Filter Status:</span>
        <a asp-action="Index" class="btn btn-sm @(!selectedStatus.HasValue ? "btn-dark" : "btn-outline-dark") rounded-pill px-3">All Orders</a>
        <a asp-action="Index" asp-route-status="@OrderStatus.Pending" class="btn btn-sm @(selectedStatus == OrderStatus.Pending ? "btn-warning" : "btn-outline-warning text-dark") rounded-pill px-3">Pending</a>
        <a asp-action="Index" asp-route-status="@OrderStatus.Processing" class="btn btn-sm @(selectedStatus == OrderStatus.Processing ? "btn-info" : "btn-outline-info text-dark") rounded-pill px-3">Processing</a>
        <a asp-action="Index" asp-route-status="@OrderStatus.Shipped" class="btn btn-sm @(selectedStatus == OrderStatus.Shipped ? "btn-primary" : "btn-outline-primary") rounded-pill px-3">Shipped</a>
        <a asp-action="Index" asp-route-status="@OrderStatus.Delivered" class="btn btn-sm @(selectedStatus == OrderStatus.Delivered ? "btn-success" : "btn-outline-success") rounded-pill px-3">Delivered</a>
        <a asp-action="Index" asp-route-status="@OrderStatus.Cancelled" class="btn btn-sm @(selectedStatus == OrderStatus.Cancelled ? "btn-danger" : "btn-outline-danger") rounded-pill px-3">Cancelled</a>
    </div>
</div>

<!-- Orders Table -->
<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Order #</th>
                        <th>Customer</th>
                        <th>Phone / Email</th>
                        <th>Items</th>
                        <th>Total</th>
                        <th>Payment</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                No orders found in this category.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var o in Model)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@o.OrderCode</td>
                                <td>
                                    <div class="fw-bold text-dark">@o.FirstName @o.LastName</div>
                                    <small class="text-muted">@o.City</small>
                                </td>
                                <td>
                                    <div>@o.Phone</div>
                                    <small class="text-muted">@o.Email</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@o.OrderItems.Count items</span>
                                </td>
                                <td class="fw-bold text-dark">$@o.TotalAmount.ToString("N2")</td>
                                <td>
                                    <small class="badge bg-secondary-subtle text-secondary border">@o.PaymentMethod</small>
                                </td>
                                <td>
                                    @switch (o.Status)
                                    {
                                        case OrderStatus.Pending:
                                            <span class="badge badge-pending px-2 py-1 rounded-pill">Pending</span>
                                            break;
                                        case OrderStatus.Processing:
                                            <span class="badge badge-processing px-2 py-1 rounded-pill">Processing</span>
                                            break;
                                        case OrderStatus.Shipped:
                                            <span class="badge badge-shipped px-2 py-1 rounded-pill">Shipped</span>
                                            break;
                                        case OrderStatus.Delivered:
                                            <span class="badge badge-delivered px-2 py-1 rounded-pill">Delivered</span>
                                            break;
                                        case OrderStatus.Cancelled:
                                            <span class="badge badge-cancelled px-2 py-1 rounded-pill">Cancelled</span>
                                            break;
                                    }
                                </td>
                                <td class="text-muted small">@o.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-end">
                                    <a asp-action="Detail" asp-route-id="@o.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        View Details &rarr;
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <div class="card-footer bg-white py-3 d-flex justify-content-between align-items-center">
                <small class="text-muted">Showing page @currentPage of @totalPages</small>
                <div class="d-flex gap-1">
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <a asp-action="Index" 
                           asp-route-page="@i" 
                           asp-route-status="@selectedStatus" 
                           class="btn btn-sm @(i == currentPage ? "btn-primary fw-bold" : "btn-outline-secondary") rounded-circle px-3 py-1">
                            @i
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>
