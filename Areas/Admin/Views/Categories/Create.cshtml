@model PetShopApp.Areas.Admin.ViewModels.CategoryFormVM
@{
    ViewData["Title"] = "New Category";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold m-0 text-dark">Create New Category</h5>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="bi bi-arrow-left me-1"></i> Back to List
                </a>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold">Category Name *</label>
                        <input asp-for="Name" class="form-control form-control-lg rounded-3" placeholder="e.g. Dog Food, Cat Clothes" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Slug" class="form-label fw-bold">Slug (Optional)</label>
                            <input asp-for="Slug" class="form-control rounded-3" placeholder="Leave empty for auto-generation" />
                            <small class="text-muted">Used in URL (e.g. dog-food)</small>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DisplayOrder" class="form-label fw-bold">Display Order</label>
                            <input asp-for="DisplayOrder" type="number" class="form-control rounded-3" value="0" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-bold">Description</label>
                        <textarea asp-for="Description" class="form-control rounded-3" rows="3" placeholder="Brief summary of category"></textarea>
                    </div>

                    <div class="form-check form-switch mb-4 fs-5">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch" checked>
                        <label class="form-check-label fs-6 fw-bold" for="isActiveSwitch">Active (Visible in Store)</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary rounded-pill px-5 py-2">
                            <i class="bi bi-check2-circle me-1"></i> Save Category
                        </button>
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4 py-2 border">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
